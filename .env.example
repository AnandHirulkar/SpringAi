# Copy to .env (never commit .env) and adjust as needed.

# --- AI provider (OpenAI or any OpenAI-compatible endpoint) ---
OPENAI_API_KEY=sk-replace-me
OPENAI_BASE_URL=https://api.openai.com
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0.2

# --- MySQL (system of record) ---
MYSQL_URL=jdbc:mysql://localhost:3306/supportiq?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
MYSQL_USERNAME=supportiq
MYSQL_PASSWORD=supportiq

# --- MongoDB (conversations + audit) ---
MONGODB_URI=mongodb://localhost:27017/supportiq

# --- PostgreSQL + pgvector (embeddings) ---
PGVECTOR_URL=jdbc:postgresql://localhost:5432/supportiq
PGVECTOR_USERNAME=supportiq
PGVECTOR_PASSWORD=supportiq
PGVECTOR_INIT_SCHEMA=true

# --- Security ---
# Must be at least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
DEV_TOKEN_ENABLED=true

# --- MCP server (optional shared secret for /mcp) ---
MCP_API_KEY=

# --- Google Cloud Pub/Sub (only with the gcp profile) ---
GCP_PROJECT_ID=
PUBSUB_TOPIC=supportiq-events
PUBSUB_PUSH_TOKEN=
